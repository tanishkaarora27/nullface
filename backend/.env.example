# ---- NullFace backend configuration (copy to .env) ----
NF_ENV=dev
NF_SERVER_SECRET=change-me-to-a-long-random-string      # HMAC key for the 64-bit canary payload + JWT signing
NF_CORS_ORIGINS=*

# Persistence (hash-only). SQLite by default; PostgreSQL 16 on Supabase/Neon in production:
# DATABASE_URL=postgresql://user:pass@host:5432/nullface
# REDIS_URL=rediss://default:pass@host:6379          # Upstash: rate limiter + call-session state

# Supabase Auth (OAuth2 / Passkeys). When set, Supabase-issued JWTs are accepted directly.
# SUPABASE_JWT_SECRET=

# ScamRadar
# GROQ_API_KEY=                                       # whisper-large-v3 Hinglish ASR (free tier)
# GOOGLE_SAFE_BROWSING_API_KEY=

# PhotoCloak tuning
NF_SSIM_FLOOR=0.96
NF_JPEG_TARGET_QUALITY=50
NF_PGD_STEPS=10
NF_WATERMARK_DELTA=28
NF_WATERMARK_REDUNDANCY=24
NF_EPHEMERAL_DIR=/dev/shm
